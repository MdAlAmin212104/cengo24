{% if preheading or heading or subheading %}
<div class="heading heading-wrap mb-3 {{ class }} {{ heading_alignment_mobile }} {{ heading_alignment }}">
    {% if preheading != blank %}
        <p class="sub-1 preheading">
            {{ preheading }}
        </p>
    {% endif %}
    {% if heading %}
        <{{ heading_tag }} class="sub-2 heading mb-0 {{ heading_size }}">
        {{ heading }}
        </{{ heading_tag }}>
    {% endif %}
    {% if subheading != blank %}
        <div class="sub-3 subheading rte mt-2 {{ subheading_class }}">
            <div class="opacity-85">
                {{ subheading }}
            </div>
        </div>
    {% endif %}
    {% if button_link and button_label != '' %}
        <div class="card-bottom">
            <a
                    {% if button_link == blank %}
                        role="link" aria-disabled="true"
                    {% else %}
                        href="{{ button_link }}"
                    {% endif %}
                    class="btn btn-{{ button_style }} position-relative z-index-1"
            >
                <span>{{- button_label | escape -}}</span>
            </a>
        </div>
    {% endif %}
    </div>
{% endif %}
