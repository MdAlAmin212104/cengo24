{% style %}
    {% if use_custom_colors_block %}
        .block-extras-color-{{ block_id }} {
        --gradient-background-block: {% if color_background_gradient_block != blank %}{{ color_background_gradient_block }}{% else %}{{ color_background_block }}{% endif %};
       {% if color_background_block != blank %}
        --color-background-block: {{ color_background_block.red }}, {{ color_background_block.green }}, {{ color_background_block.blue }};
        {% endif %}
         {% if color_text_block != blank %}
        --color-foreground-block: {{ color_text_block.red }}, {{ color_text_block.green }}, {{ color_text_block.blue }};
        }
         {% endif %}
    {% endif %}
    {% if use_overlay %}
        .card-overlay-{{ block_id }} {
        --color-overlay: {{ colors_overlay.red }}, {{ colors_overlay.green }}, {{ colors_overlay.blue }};
        --color-overlay-opacity: {{ overlay_opacity }};
        }
    {% endif %}
{% endstyle %}

<div
        class="cs-card card-banner rounded-0 card-banner-one {{ style }} {{ style_hover }}"
>
    <div
            class="
      clearfix position-relative {% if image_height_mobile != 'mb-adapt' or image_height != 'adapt' %}card-img-custom-height {% endif %}
      {% if image_height_mobile == 'mb-adapt' %}mb-card-adapt{% else %} {{ image_height_mobile }} {% endif %} {% if image_height == 'adapt' %}card-adapt {% else %}{{ image_height }} {% endif %}
    "
    >
        <div class="card-img-top lh-0 d-block overflow-hidden{% if use_overlay %} card-overlay card-overlay-{{ block_id }}{% endif %}">
            {% if button_link %}
                <a class="full-width-link" aria-label="{{ heading }}" href="{{ button_link }}">
                    <span class="visually-hidden">{{ heading }}</span>
                </a>
            {% endif %}
            {% if video_mobile %}
                <div class="d-block d-md-none video-custom-wrapper">
                   {{ video_mobile | video_tag: image_size: '600x', autoplay: true, loop: true,muted: false, controls: false }}
                    <button class="unmute-btn animation-player-icon z-index-11 position-absolute bottom-0 end-0 mb-5 me-5"><i class="bi bi-music-note-beamed"></i></button>
                </div>
            {% else %}
                {% if image_mobile != blank %}
                    <div class="d-block d-md-none">
                        {% render 'image-lg',image: image_mobile, class: 'w-100' %}
                    </div>
                {% endif %}
            {% endif %}

            {% if video != blank  %}
                <div class="media-wrap video-custom-wrapper {% if image_mobile != blank or video_mobile != blank %}d-none d-md-block{% endif %}">
                        {{ video | video_tag: image_size: '600x', autoplay: true, loop: true,muted: false, controls: false }}
                        <button class="unmute-btn animation-player-icon z-index-11 position-absolute bottom-0 end-0 mb-5 me-5"><i class="bi bi-music-note-beamed"></i></button>
                </div>
            {% else %}
                {% if image != blank %}
                    <div class="media-wrap {% if image_mobile != blank or video_mobile != blank %}d-none d-md-block{% endif %}">
                        {% render 'image-lg', image: image, class: 'w-100' %}
                    </div>
                {% else %}
                    <div class="media-wrap {% if image_mobile != blank or video_mobile != blank %}d-none d-md-block{% endif %}">
                        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg bg-body-tertiary' }}
                    </div>
                {% endif %}
            {% endif %}
        </div>
        <a href="{{ button_link }}">
        <div class="cs-card-body animation-active {{ animation }} container page-width {{ text_box_position_mobile }} {{ text_box_position }} {{ text_alignment }} {{ text_alignment_mobile }}">
                <div class="cs-card-body-inner {% if color_background_block == "rgba(0,0,0,0)" and use_custom_colors_block %} py-4 px-0 {% else %} p-2 p-lg-5 rounded-3{% endif %} {% if use_custom_colors_block %} block-extras-color block-extras-color-{{ block_id }}{% endif %}" style="max-width: {{ max_width }}px">
                    <div class="card-top">
                        {% if preheading or heading or subheading %}
                            <div class="heading-wrap {{ class }} {{ heading_alignment_mobile }} {{ heading_alignment }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
                                {% if preheading != blank %}
                                    <p class="sub-1 text-primary fs-25 mb-0">
                                        {{ preheading }}
                                    </p>
                                {% endif %}
                                {% if heading %}
                                    <div class="sub-2 {{ style_text }}">
                                        {% render 'h-heading',
                                                heading_tag: heading_tag,
                                                heading_size:heading_size,
                                                heading: heading,
                                                heading2: heading2
                                        %}
                                    </div>
                                {% endif %}
                                {% if subheading != blank %}
                                    <div class="sub-3 subheading rte mb-0 mt-2 {{ subheading_class }}">
                                        {{ subheading }}
                                    </div>
                                {% endif %}
                                {% if button_link and button_label != '' %}
                                    <div class="sub-4 card-bottom mt-3 mt-lg-3">
                                        <a
                                                {% if button_link == blank %}
                                                    role="link" aria-disabled="true"
                                                {% else %}
                                                    href="{{ button_link }}"
                                                {% endif %}
                                                class="btn btn-{{ button_style }} position-relative z-index-1 mw-auto"
                                        >
                                            <span>{{- button_label | escape -}}</span>
                                        </a>
                                    </div>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>
                </div>
        </div>
    </a>
    </div>
</div>
