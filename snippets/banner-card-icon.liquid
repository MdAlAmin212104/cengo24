<div class="card-icon horizontal position-relative {{ class }}">
  {% if icon != ''  or image != '' or svg != ''  %}
    <div
    class="card-icon-top item-hover mb-3 {% if style == 'vertical' %} me-3 {% endif %}"
  >
        <div class="icon">
            {% if image != blank %}
                {% render 'image-sm', image: image %}
            {% else %}
                {% if enable_svg and svg != '' %}
                    {{ svg }}
                {% else %}
                        <i class="bi {{ icon }}"></i>
                {% endif %}
            {% endif %}
        </div>

  </div>
    {% endif %}
  <div class="card-icon-body px-0 px-xl-4">
    {% if heading != '' %}
      <{{ heading_tag }} class="mb-1 fs-22">
        {{ heading }}
      </{{ heading_tag }}>
    {% endif %}
    {% if subheading != '' %}
      <div class="rte card-text subheading opacity-85 rte-inline {{ class_subheading }}">
        {{ subheading }}
      </div>
    {% endif %}
  </div>
</div>
