<div class="container page-width password-footer">
    {% if section.settings.show_share_buttons %}
        <ul class="list-social list-unstyled d-flex align-items-center justify-content-center flex-wrap" role="list">
            {%- if settings.social_twitter_link != blank -%}
                <li class="list-social__item mx-2">
                    <a href="{{ settings.social_twitter_link }}" class="link social-icons__link">
                          <span>
                          <i class="bi bi-twitter"></i>
                          </span>
                        <span class="visually-hidden">{{ 'general.social.links.twitter' | t }}</span>
                    </a>
                </li>
            {%- endif -%}
            {%- if settings.social_facebook_link != blank -%}
                <li class="list-social__item mx-2">
                    <a href="{{ settings.social_facebook_link }}" class="link social-icons__link">
          <span>
             <i class="bi bi-facebook"></i>
          </span>
                        <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
                    </a>
                </li>
            {%- endif -%}
            {%- if settings.social_pinterest_link != blank -%}
                <li class="list-social__item mx-2">
                    <a href="{{ settings.social_pinterest_link }}" class="link social-icons__link">
          <span>
           <i class="bi bi-pinterest"></i>
          </span>
                        <span class="visually-hidden">{{ 'general.social.links.pinterest' | t }}</span>
                    </a>
                </li>
            {%- endif -%}
            {%- if settings.social_instagram_link != blank -%}
                <li class="list-social__item mx-2">
                    <a href="{{ settings.social_instagram_link }}" class="link social-icons__link">
          <span>
           <i class="bi bi-instagram"></i>
          </span>
                        <span class="visually-hidden">{{ 'general.social.links.instagram' | t }}</span>
                    </a>
                </li>
            {%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}
                <li class="list-social__item mx-2">
                    <a href="{{ settings.social_tiktok_link }}" class="link social-icons__link">
          <span>
           <i class="bi bi-tiktok"></i>
          </span>
                        <span class="visually-hidden">{{ 'general.social.links.tiktok' | t }}</span>
                    </a>
                </li>
            {%- endif -%}
            {%- if settings.social_snapchat_link != blank -%}
                <li class="list-social__item mx-2">
                    <a href="{{ settings.social_snapchat_link }}" class="link social-icons__link">
          <span>
           <i class="bi bi-snapchat"></i>
          </span>
                        <span class="visually-hidden">{{ 'general.social.links.snapchat' | t }}</span>
                    </a>
                </li>
            {%- endif -%}
            {%- if settings.social_youtube_link != blank -%}
                <li class="list-social__item mx-2">
                    <a href="{{ settings.social_youtube_link }}" class="link social-icons__link">
          <span>
           <i class="bi bi-youtube"></i>
          </span>
                        <span class="visually-hidden">{{ 'general.social.links.youtube' | t }}</span>
                    </a>
                </li>
            {%- endif -%}
            {%- if settings.social_vimeo_link != blank -%}
                <li class="list-social__item mx-2">
                    <a href="{{ settings.social_vimeo_link }}" class="link social-icons__link">
          <span>
            <i class="bi bi-vimeo"></i>
          </span>
                        <span class="visually-hidden">{{ 'general.social.links.vimeo' | t }}</span>
                    </a>
                </li>
            {%- endif -%}
        </ul>
    {% endif %}

    <div class="password-powered-by text-center">
        <small>{{ powered_by_link }}</small>
    </div>
</div>

{% schema %}
{
  "name": "t:sections.password-footer.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_share_buttons",
      "label": "t:sections.password-footer.settings.show_share_buttons.label",
      "default": true
    }
  ]
}
{% endschema %}
