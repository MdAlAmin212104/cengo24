    },
    {
      "type": "header",
      "content": "t:sections.all.custom.header"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "t:sections.all.custom.custom_id"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.all.custom.custom_class"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.gallery.block.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.all.image.label"
        },
        {
          "type": "url",
          "id": "image_link",
          "default": "/collections/all",
          "label": "t:sections.all.image.label_link"
        },
        {
          "type": "text",
          "id": "icon_hover",
          "default": "bi-instagram",
