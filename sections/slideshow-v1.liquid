    {
      "type": "header",
      "content": "t:sections.all.mobile.header"
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "t:sections.all.text_alignment.label_mobile",
      "options": [
        {
          "value": "text-start",
          "label": "t:sections.all.text_alignment.options__1.label"
        },
        {
          "value": "text-center",
          "label": "t:sections.all.text_alignment.options__2.label"
        },
        {
          "value": "text-end",
          "label": "t:sections.all.text_alignment.options__3.label"
        }
      ],
      "default": "text-center"
    },
    {
      "type": "header",
      "content": "t:sections.all.custom.header"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "t:sections.all.custom.custom_id"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.all.custom.custom_class"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "limit": 5,
      "name": "t:sections.slideshow-v1.block.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.all.image.label"
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.all.video.label"
        },
        {
          "type": "select",
          "id": "image_position",
          "options": [
            {
              "value": "object_position_top_left",
              "label": "t:sections.all.image.image_position.options__1.label"
