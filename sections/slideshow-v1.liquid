<link rel="stylesheet"
      href="{{ 'animations-swipe.css' | asset_url }}"
      media="print"
      onload="this.media='all'">
<noscript><link rel="stylesheet" href="{{ 'animations-swipe.css' | asset_url }}"></noscript>

{% style %}
    .section-extras-spacing-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-margin-top: {{ section.settings.margin_top }}px;
    --section-margin-bottom: {{ section.settings.margin_bottom }}px;
    }
{% endstyle %}
<div
        class="
    slideshow-v1 section-extras-spacing section-extras-spacing-{{ section.id }}
    {% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %} {{ section.settings.style_slider }}
  "
        {% if section.settings.custom_id != blank %}
            id="{{ section.settings.custom_id }}"
        {% endif %}
>
    <div class="{{ section.settings.layout }} position-relative">
        <div class="position-relative">
            <div class="hero-slider style-v1">
                <div
                        class="swiper-container overflow-hidden"
                        data-slide='
              {
                        "slidesPerView": 1,
                          {% if section.settings.auto_rotate %}
              "autoplay": {"delay": {{ section.settings.change_slides_speed }}000},
              {% endif %}
               "lazy": true,
              "speed": 400,
              "effect": "fade",
          "fadeEffect": {
          "crossFade": true
          },
              "loop": {{ section.settings.loop }},
                        "autoHeight": true,
                        "spaceBetween": 0,
                        {% if section.settings.enable_navigation %}
                                "navigation": {"nextEl": ".cs-swiper-button-next{{ section.id }}", "prevEl": ".cs-swiper-button-prev{{ section.id }}"},
                                {% endif %}
                                {% if section.settings.enable_pagination %}
                                "pagination": {
                                  "el": ".swiper-pagination",
                                   {% if section.settings.slider_visual != blank and section.settings.slider_visual != 'bullets' %}
                                   "type": "{{ section.settings.slider_visual }}",
                                   {% endif %}
                                   {% if section.settings.slider_visual == 'bullets' %}
                                    "dynamicBullets": "true",
                                   {% endif %}
                                   "clickable": true
                                },
                                {% endif %}
                                 "spaceBetween": 0
                    }
        '
                >
                    <div class="swiper-wrapper{% if section.settings.enable_pagination or section.settings.enable_navigation %} have-action{% endif %}">
                        {% for block in section.blocks %}
                            <div class="swiper-slide" {{ block.shopify_attributes }}>

                              {% style %}
                                {% if block.settings.use_custom_colors_block %}
                                  .block-extras-color-{{ block.id }} {
                                  --gradient-background-block: {% if block.settings.color_background_gradient_block != blank %}{{ block.settings.color_background_gradient_block }}{% else %}{{ block.settings.color_background_block }}{% endif %};
                                  --color-background-block: {{ block.settings.color_background_block.red }}, {{ block.settings.color_background_block.green }}, {{ block.settings.color_background_block.blue }};
                                  --color-foreground-block: {{ block.settings.color_text_block.red }}, {{ block.settings.color_text_block.green }}, {{ block.settings.color_text_block.blue }};
                                  }
                                {% endif %}
                                {% if block.settings.use_overlay %}
                                  .card-overlay-{{ block.id }} {
                                  --color-overlay: {{ block.settings.colors_overlay.red }}, {{ block.settings.colors_overlay.green }}, {{ block.settings.colors_overlay.blue }};
                                  --color-overlay-opacity: {{ block.settings.overlay_opacity }};
                                  }
                                {% endif %}
                              {% endstyle %}
                              <div class="cs-card card-banner style-1{% if block.settings.use_custom_colors_block %} block-extras-color block-extras-color-{{ block.id }}{% endif %}">
                                <div class="clearfix position-relative">
                                  <div class="row gx-0 flex-md-row-reverse">
                                    <div class="col-12 col-md-{{ section.settings.image_width }}">
                                      <div class="card-img-top position-relative lh-0 d-block overflow-hidden {% if section.settings.image_height == 'adapt' %} card-adapt{% else %} mb-card-adapt card-img-custom-height {{ section.settings.image_height }} {% endif %}{% if block.settings.use_overlay %} card-overlay card-overlay-{{ block.id }}{% endif %}">
                                        {% if block.settings.video_mobile != blank %}
                                          <div class="d-block d-md-none">
                                            {{
                                            block.settings.video_mobile
                                            | video_tag: image_size: '600x', autoplay: true, loop: true, muted: true, controls: false
                                            }}
                                          </div>
                                        {% else %}
                                          {% if block.settings.image_mobile != blank %}
                                            <div class="d-block d-md-none">
                                            {%- if forloop.first %}
                                              {% render 'image',image: block.settings.image_mobile, fetch: true %}
                                            {% else %}
                                              {% render 'image',image: block.settings.image_mobile, fetch: false %}
                                              <div class="swiper-lazy-preloader swiper-lazy-preloader-white"></div>
                                            {% endif %}
                                            </div>
                                          {% endif %}
                                        {% endif %}
                                        {% if block.settings.video != blank %}
                                          <div class="media-wrap {% if block.settings.image_mobile != blank or block.settings.video_mobile != blank %}d-none d-md-block{% endif %}">
                                            {{ block.settings.video | video_tag: image_size: '600x', autoplay: true, loop: true, muted: true, controls: false }}
                                          </div>
                                        {% else %}
                                          {% if block.settings.image != blank %}
                                            <div class="media-wrap {% if block.settings.image_mobile != blank or block.settings.video_mobile != blank %}d-none d-md-block{% endif %}">

                                              {%- if forloop.first %}
                                                {% render 'image-lg',image: block.settings.image, fetch: true %}
                                              {% else %}
                                                {% render 'image-lg',image: block.settings.image, fetch: false %}
                                              {% endif %}
                                            </div>
                                          {% else %}
                                            <div class="media-wrap {% if block.settings.image_mobile != blank or block.settings.video_mobile != blank %}d-none d-md-block{% endif %}">
                                              {{ 'image' | placeholder_svg_tag: 'placeholder-svg bg-body-tertiary' }}
                                            </div>
                                          {% endif %}
                                        {% endif %}

                                      </div>
                                    </div>
                                    <div class="col-content col-12 col-md-{{ 12 | minus: section.settings.image_width }}">
                                      <div class="cs-card-body animation-active {{ section.settings.animation }} position-relative {{ section.settings.text_box_position }} {{ section.settings.text_alignment }} {{ section.settings.text_alignment_mobile }}">
                                        <div class="cs-card-body-inner px-3 pt-4 pb-5 p-lg-5{% if section.settings.heading_size == 'h-custom' %} position-relative-767 position-absolute start-0{% endif %}" style="max-width: {{ section.settings.max_width }}px">
                                          <div class="card-top {{ section.settings.style_text }}">
                                            {% if block.settings.preheading or block.settings.heading or block.settings.subheading %}
                                            <div class="heading heading-wrap {{ section.settings.heading_alignment_mobile }} {{ section.settings.heading_alignment }}">
                                              {% if block.settings.preheading != blank %}
                                                <p class="sub-1 preheading">
                                                  {{ block.settings.preheading }}
                                                </p>
                                              {% endif %}
                                              {% if block.settings.heading %}
                                              <{{ section.settings.heading_tag }} class="sub-2 heading mb-3 {{ section.settings.heading_size }}">
                                              {{ block.settings.heading }}
                                              {% if block.settings.heading_2 != blank %}
                                                <br>{{ block.settings.heading_2 }}
                                              {% endif %}
                                            </{{ section.settings.heading_tag }}>
                                            {% endif %}
                                            {% if block.settings.subheading != blank %}
                                              <div class="sub-3 subheading rte mb-3">
                                                {{ block.settings.subheading }}
                                              </div>
                                            {% endif %}
                                          </div>
                                          {% endif %}
                                        </div>
                                        {% if block.settings.button_link and block.settings.button_label != '' %}
                                          <div class="card-bottom sub-4">
                                            <a
                                                    {% if block.settings.button_link == blank %}
                                                      role="link" aria-disabled="true"
                                                    {% else %}
                                                      href="{{ block.settings.button_link }}"
                                                    {% endif %}
                                                    class="w-xs-100 btn btn-{{ block.settings.button_style }} position-relative z-index-1"
                                            >
                                              <span>{{- block.settings.button_label | escape -}}</span>
                                            </a>
                                          </div>
                                        {% endif %}
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              </div>
                            </div>
                            </div>
                        {% endfor %}
                    </div>
                    {% if section.settings.enable_navigation %}
                        <div class="cs-navigation style-inner style-center">
                            {% if section.settings.enable_navigation %}
                                {% render 'navigation-prev',
                                        section_id: section.id,
                                        navigation_icon: section.settings.navigation_icon
                                %}
                                {% render 'navigation-next',
                                        section_id: section.id,
                                        navigation_icon: section.settings.navigation_icon
                                %}
                            {% endif %}
                        </div>
                    {% endif %}
                    {% if section.settings.enable_pagination %}
                        <div class="swiper-pagination position-absolute start-50 translate-middle-x"></div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

{% schema %}
{
  "name": "t:sections.slideshow-v1.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "style_text",
      "options": [
        {
          "value": "none-style-text",
          "label": "t:sections.all.style.options__0.label"
        },
        {
          "value": "text-style-1",
          "label": "t:sections.all.style.options__1.label"
        },
        {
          "value": "text-style-2",
          "label": "t:sections.all.style.options__2.label"
        },
        {
          "value": "text-style-3",
          "label": "t:sections.all.style.options__3.label"
        }
      ],
      "default": "none-style-text",
      "label": "t:sections.all.style.label_text_style"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options__6.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_tag.label",
      "info": "t:sections.all.heading_tag.info"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h-custom-v1",
          "label": "t:sections.all.heading_size.options__custom1.label"
        },
        {
          "value": "h-custom",
          "label": "t:sections.all.heading_size.options__custom.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__0.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_size.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_size.options__6.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.layout.header"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "container page-width",
          "label": "t:sections.all.layout.options__1.label"
        },
        {
          "value": "container container-inner",
          "label": "t:sections.all.layout.options__2.label"
        },
        {
          "value": "container-fluid",
          "label": "t:sections.all.layout.options__3.label"
        },
        {
          "value": "full-width",
          "label": "t:sections.all.layout.options__4.label"
        }
      ],
      "default": "full-width",
      "label": "t:sections.all.layout.header"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 300,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "t:sections.all.content.max_width",
      "default": 600
    },
    {
      "type": "select",
      "id": "image_width",
      "options": [
        {
          "value": "5",
          "label": "5/12 (41.67%)"
        },
        {
          "value": "6",
          "label": "6/12 (50%)"
        },
        {
          "value": "7",
          "label": "7/12 (58.33%)"
        },
        {
          "value": "8",
          "label": "8/12 (66.67%)"
        },
        {
          "value": "9",
          "label": "9/12 (75%)"
        }
      ],
      "default": "7",
      "label": "t:sections.all.image.image_width.label"
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.all.image.image_height.options__1.label"
        },
        {
          "value": "h-300",
          "label": "300px"
        },
        {
          "value": "h-350",
          "label": "350px"
        },
        {
          "value": "h-400",
          "label": "400px"
        },
        {
          "value": "h-450",
          "label": "450px"
        },
        {
          "value": "h-500",
          "label": "500px"
        },
        {
          "value": "h-550",
          "label": "550px"
        },
        {
          "value": "h-600",
          "label": "600px"
        },
        {
          "value": "h-650",
          "label": "650px"
        },
        {
          "value": "h-700",
          "label": "700px"
        },
        {
          "value": "h-800",
          "label": "800px"
        }
      ],
      "default": "adapt",
      "label": "t:sections.all.image.image_height.label"
    },
    {
      "type": "select",
      "id": "text_box_position",
      "label": "t:sections.all.text_box_position.label",
      "options": [
        {
          "value": "flex-top-left",
          "label": "t:sections.all.text_box_position.options__1.label"
        },
        {
          "value": "flex-top-center",
          "label": "t:sections.all.text_box_position.options__2.label"
        },
        {
          "value": "flex-top-right",
          "label": "t:sections.all.text_box_position.options__3.label"
        },
        {
          "value": "flex-middle-left",
          "label": "t:sections.all.text_box_position.options__4.label"
        },
        {
          "value": "flex-middle-center",
          "label": "t:sections.all.text_box_position.options__5.label"
        },
        {
          "value": "flex-middle-right",
          "label": "t:sections.all.text_box_position.options__6.label"
        },
        {
          "value": "flex-bottom-left",
          "label": "t:sections.all.text_box_position.options__7.label"
        },
        {
          "value": "flex-bottom-center",
          "label": "t:sections.all.text_box_position.options__8.label"
        },
        {
          "value": "flex-bottom-right",
          "label": "t:sections.all.text_box_position.options__9.label"
        }
      ],
      "default": "flex-middle-center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.all.text_alignment.label_desktop",
      "options": [
        {
          "value": "text-md-start text-lg-start",
          "label": "t:sections.all.text_alignment.options__1.label"
        },
        {
          "value": "text-md-center text-lg-center",
          "label": "t:sections.all.text_alignment.options__2.label"
        },
        {
          "value": "text-md-end text-lg-end",
          "label": "t:sections.all.text_alignment.options__3.label"
        }
      ],
      "default": "text-md-center text-lg-center"
    },
    {
      "type": "header",
      "content": "t:sections.all.video.header"
    },
    {
      "type": "checkbox",
      "id": "enable_controls",
      "default": false,
      "label": "t:sections.all.video.enable_controls"
    },
    {
      "type": "header",
      "content": "t:sections.all.carousel.header"
    },
    {
      "type": "select",
      "id": "animation",
      "options": [
        {
          "value": "none",
          "label": "t:sections.all.carousel.animation.options__1.label"
        },
        {
          "value": "animation-left-to-right",
          "label": "t:sections.all.carousel.animation.options__ltr.label"
        },
        {
          "value": "animation-right-to-left",
          "label": "t:sections.all.carousel.animation.options__rtl.label"
        },
        {
          "value": "animation-top-to-bottom",
          "label": "t:sections.all.carousel.animation.options__ttb.label"
        },
        {
          "value": "animation-bottom-to-top",
          "label": "t:sections.all.carousel.animation.options__btt.label"
        },
        {
          "value": "animation-left-right-odds",
          "label": "t:sections.all.carousel.animation.options__lrodds.label"
        },
        {
          "value": "animation-random",
          "label": "t:sections.all.carousel.animation.options__rd.label"
        }
      ],
      "default": "animation-bottom-to-top",
      "label": "t:sections.all.carousel.animation.label"
    },
    {
      "type": "select",
      "id": "style_slider",
      "label": "t:sections.all.carousel.style",
      "options": [
        {
          "value": "slide-light",
          "label": "t:sections.all.carousel.style_white"
        },
        {
          "value": "slide-dark",
          "label": "t:sections.all.carousel.style_dark"
        }
      ],
      "default": "slide-dark"
    },
    {
      "type": "checkbox",
      "id": "enable_navigation",
      "label": "t:sections.all.carousel.enable_navigation",
      "default": true
    },
    {
      "type": "select",
      "id": "navigation_icon",
      "label": "t:sections.all.carousel.navigation_icon.label",
      "options": [
        {
          "value": "style-1",
          "label": "t:sections.all.carousel.navigation_icon.options__0.label"
        },
        {
          "value": "style-2",
          "label": "t:sections.all.carousel.navigation_icon.options__1.label"
        }
      ],
      "default": "style-1"
    },
    {
      "type": "checkbox",
      "id": "enable_pagination",
      "label": "t:sections.all.carousel.enable_pagination",
      "default": true
    },
    {
      "type": "select",
      "id": "slider_visual",
      "options": [
        {
          "value": "",
          "label": "t:sections.all.carousel.slider_visual.options__1.label"
        },
        {
          "value": "bullets",
          "label": "t:sections.all.carousel.slider_visual.options__2.label"
        },
        {
          "value": "fraction",
          "label": "t:sections.all.carousel.slider_visual.options__3.label"
        },
        {
          "value": "progressbar",
