{%- unless section.settings.quick_add == 'none' -%}
    {{ 'quick-add.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'product-form.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'quick-add.min.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{% style %}
    .section-extras-margin-{{ section.id }} {
    --section-margin-top: {{ section.settings.margin_top }}px;
    --section-margin-bottom: {{ section.settings.margin_bottom }}px;
    }
    .section-extras-padding-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    {% if section.settings.use_custom_colors %}
        .section-extras-color-{{ section.id }} {
        --gradient-background: {% if section.settings.color_background_gradient != blank %}{{ section.settings.color_background_gradient }}{% else %}{{ section.settings.color_background }}{% endif %};
        --color-background: {{ section.settings.color_background.red }}, {{ section.settings.color_background.green }}, {{ section.settings.color_background.blue }};
        --color-foreground: {{ section.settings.color_text.red }}, {{ section.settings.color_text.green }}, {{ section.settings.color_text.blue }};
        }
    {% endif %}
    {% if section.settings.show_border %}
        .settings-border-{{ section.id }}.settings-card{
        border: {{ section.settings.border_width }}px {{ section.settings.border_style }} {{ section.settings.color_border }};
        border-radius: {{ section.settings.border_radius }}px;
        }
    {% endif %}
{% endstyle %}
<div
        class="{% if section.settings.use_custom_colors %} section-extras-color section-extras-color-{{ section.id }} {% endif %} section-extras-margin section-extras-margin-{{ section.id }}
     {% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %} {{ section.settings.style_slider }}
  "
        {% if section.settings.custom_id != blank %}
            id="{{ section.settings.custom_id }}"
        {% endif %}
>
    <div class="section-extras-padding section-extras-padding-{{ section.id }}{% if section.settings.enable_parallax and section.settings.background_image != blank %} jarallax{% endif %}{% if section.settings.enable_overlay_image %} overlay-product-image{% endif %}"
            {% if section.settings.enable_parallax and section.settings.background_image != blank %}
                data-jarallax data-speed="{{ section.settings.speed }}" data-type="{{ section.settings.type }}"
                style="background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}')"
            {% endif %}
    >
        <div class="{{ section.settings.layout }} position-relative">
            {% if section.settings.preheading != '' or section.settings.heading != '' or section.settings.subheading != '' %}
                <div class="heading heading-wrap {{ section.settings.heading_alignment }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
                    <div class="clearfix">
                        {% if section.settings.preheading != blank %}
                            <p class="preheading">
                                <span>
                                    {{ section.settings.preheading }}
                                </span>
                            </p>
                        {% endif %}
                        {% render 'h-heading',
                                heading_tag: section.settings.heading_tag,
                                heading_size: section.settings.heading_size,
                                heading: section.settings.heading,
                                animation: 'none'
                        %}

                        {% if section.settings.subheading != blank %}
                            <div class="subheading rte mt-2">
                                <div class="opacity-85">
                                    {{ section.settings.subheading }}
                                </div>
                            </div>
                        {% endif %}
                    </div>

                </div>
            {% endif %}
            <div class="hero-slider position-static{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
                <div
                        {% if section.settings.enable_slider %}
                            class="swiper-container overflow-hidden"
                            data-slide='
                {
                    "slidesPerView": {{ section.settings.columns_desktop }},
                    {% if section.settings.auto_rotate %}
                    "autoplay": {"delay": {{ section.settings.change_slides_speed }}000},
                    {% endif %}
                    "loop": {{ section.settings.loop }},
                    "autoHeight": true,
                    "spaceBetween": 0,
                    {% if section.settings.enable_navigation %}
                    "navigation": {"nextEl": ".cs-swiper-button-next{{ section.id }}", "prevEl": ".cs-swiper-button-prev{{ section.id }}"},
                    {% endif %}
                    {% if section.settings.enable_pagination %}
                    "pagination": {
                      "el": ".swiper-pagination",
                       {% if section.settings.slider_visual != blank and section.settings.slider_visual != 'bullets' %}
                       "type": "{{ section.settings.slider_visual }}",
                       {% endif %}
                       {% if section.settings.slider_visual == 'bullets' %}
                        "dynamicBullets": "true",
                       {% endif %}
                       "clickable": true
                    },
                    {% endif %}
                    "breakpoints": {
                      "0": { "slidesPerView": {{ section.settings.columns_mobile }}, "spaceBetween": 10 },
                      "480": {"slidesPerView": {{ section.settings.columns_mobile }},"spaceBetween": 20 },
                      "768": { "slidesPerView": {{ section.settings.columns_tablet }}, "spaceBetween": 20 },
                      "992": { "slidesPerView": {{ section.settings.columns_desktop }},"spaceBetween": 20 },
                      "1200": {"slidesPerView": {{ section.settings.columns_desktop }},"spaceBetween": 20 }
                    }
                }
              '
                        {% endif %}
                >
                    <div
                            class="
                {% if section.settings.enable_slider %}
                  swiper-wrapper align-items-normal
                {% else %}
                  row{% if section.settings.gutter == 0 %} row-border gx-0{% else %} gx-2 gx-lg-{{ section.settings.gutter }}{% endif %}
                  row-cols-{{ section.settings.columns_mobile }}
                  row-cols-md-{{ section.settings.columns_tablet }}
                  row-cols-lg-{{ section.settings.columns_desktop }}
                {% endif %}
              "
                    >
                        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
                            <div
                                    class="position-relative {% if section.settings.enable_slider %} swiper-slide{% else %}col mb-{{ section.settings.gutter }}{% endif %}"
                            >
                                <div class="card-wrapper card-product w-100 h-100">
                                    {% render 'card-product',
                                            card_product: product,
                                            section_id: section.id,
                                            show_border: section.settings.show_border,
                                            image_position: section.settings.image_position,
                                            image_height: section.settings.image_height,
                                            show_quick_add: section.settings.enable_quick_add,
                                            show_secondary_image: section.settings.show_secondary_image,
                                            show_variant_image: section.settings.show_variant_image,
                                            style_product: section.settings.style
                                    %}
                                </div>
                            </div>
                        {% else %}
                            {% for i in (1..section.settings.products_to_show) %}
                                <div class="d-flex justify-content-between flex-column {% if section.settings.enable_slider %} swiper-slide{% else %}col mb-{{ section.settings.gutter }}{% endif %}">
                                    {% if section.settings.style == 'style-1' %}
                                        <div class="card-wrapper card-product w-100 h-100">
                                            <div class="card-product-inner d-flex justify-content-between flex-column h-100">
                                                <div class="product-card style-v1 position-relative">
                                                    <div class="mb-3 overflow-hidden position-relative">
                                                        <a class="full-width-link" aria-label="{{ 'onboarding.product_title' | t }}" href="#">
                                                            <span class="visually-hidden">{{ 'onboarding.product_title' | t }}</span>
                                                        </a>
                                                        <div class="card-img-top hover-secondary-image {% if section.settings.image_height == 'adapt' %} card-adapt{% else %} card-img-custom-height {{ section.settings.image_height }} {% endif %}">
                                                            {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                                                            {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                                                        </div>

                                                        <div class="hover-slide-left">
                                                            <div class="item-1 action-btn z-index-11">
                                                                <button type="button" aria-label="Add to wishlist"
                                                                        class="btn-action btn-icon">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="24"
                                                                         height="24" viewBox="0 0 24 24" fill="none"
                                                                         stroke="currentColor" stroke-width="1.2"
                                                                         stroke-linecap="round" stroke-linejoin="round"
                                                                         class="icon-wishlist feather feather-heart">
                                                                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                                                    </svg>
                                                                </button>
                                                            </div>
                                                            <div class="item-2 mt-2">
                                                                <button class="button btn-icon">
                                                                    <i class="bi bi-eye"></i>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="card-content pb-0">
                                                        <h3 class="fs-16 card-product-title mb-2"
                                                            aria-hidden="true">{{ 'onboarding.product_title' | t }}</h3>
                                                        <div class="d-flex flex-nowrap align-items-center">
                                                            <div class="price price--listing font-body">
                                                                $19.99 <p class="fs-16 mb-0"><span
                                                                            class="mx-1">|</span>300g</p>
                                                            </div>
                                                        </div>
                                                        <div class="quick-add">
                                                            <button class="quick-add__submit btn btn-primary">
                                                                {{ 'products.product.add_to_cart' | t }}
                                                            </button>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% endif %}
                                    {% if section.settings.style == 'style-2' %}
                                        <div class="card-wrapper card-product w-100 h-100">
                                            <div class="card-product-inner d-flex justify-content-between flex-column h-100">
                                                <div class="product-card style-v2 position-relative">
                                                    <div class="mb-3 overflow-hidden position-relative">
                                                        <a class="full-width-link" aria-label="{{ 'onboarding.product_title' | t }}" href="#">
                                                            <span class="visually-hidden">{{ 'onboarding.product_title' | t }}</span>
                                                        </a>
                                                        <div class="card-img-top hover-secondary-image {% if section.settings.image_height == 'adapt' %} card-adapt{% else %} card-img-custom-height {{ section.settings.image_height }} {% endif %}">
                                                            {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                                                            {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                                                        </div>

                                                        <div class="hover-slide-left">
                                                            <div class="item-1 action-btn z-index-11">
                                                                <button type="button" aria-label="Add to wishlist"
                                                                        class="btn-action btn-icon">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="24"
                                                                         height="24" viewBox="0 0 24 24" fill="none"
                                                                         stroke="currentColor" stroke-width="1.2"
                                                                         stroke-linecap="round" stroke-linejoin="round"
                                                                         class="icon-wishlist feather feather-heart">
                                                                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                                                    </svg>
                                                                </button>
                                                            </div>
                                                            <div class="item-2 mt-2">
                                                                <button class="button btn-icon">
                                                                    <i class="bi bi-eye"></i>
                                                                </button>
                                                            </div>
                                                        </div>
                                                        <div class="position-absolute end-0 bottom-0 mx-2 z-index-11">
                                                            <button class="quick-add__submit btn btn-primary btn-icon">
                                                                <i class="bi bi-bag"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <div class="card-content pb-0">
                                                        <h3 class="fs-16 card-product-title mb-2"
                                                            aria-hidden="true">{{ 'onboarding.product_title' | t }}</h3>
                                                        <div class="d-flex flex-nowrap align-items-center">
                                                            <div class="price price--listing font-body">
                                                                $19.99 <p class="fs-16 mb-0"><span
                                                                            class="mx-1">|</span>300g</p>
                                                            </div>
                                                        </div>


                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% endif %}
                                    {% if section.settings.style == 'style-3' %}
                                        <div class="card-wrapper card-product w-100 h-100">
                                            <div class="card-product-inner d-flex justify-content-between flex-column h-100">
                                                <div class="product-card style-v3 position-relative">
                                                    <div class="mb-3 overflow-hidden position-relative">
                                                        <a class="full-width-link" aria-label="{{ 'onboarding.product_title' | t }}" href="#">
                                                            <span class="visually-hidden">{{ 'onboarding.product_title' | t }}</span>
                                                        </a>
                                                        <div class="card-img-top hover-secondary-image {% if section.settings.image_height == 'adapt' %} card-adapt{% else %} card-img-custom-height {{ section.settings.image_height }} {% endif %}">
                                                            {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                                                            {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                                                        </div>

                                                        <div class="hover-slide-left">
                                                            <div class="item-1 action-btn z-index-11">
                                                                <button type="button" aria-label="Add to wishlist"
                                                                        class="btn-action btn-icon">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="24"
                                                                         height="24" viewBox="0 0 24 24" fill="none"
                                                                         stroke="currentColor" stroke-width="1.2"
                                                                         stroke-linecap="round" stroke-linejoin="round"
                                                                         class="icon-wishlist feather feather-heart">
                                                                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                                                    </svg>
                                                                </button>
                                                            </div>
                                                            <div class="item-2 mt-2">
                                                                <button class="button btn-icon">
                                                                    <i class="bi bi-eye"></i>
                                                                </button>
                                                            </div>
                                                        </div>
                                                        <div class="custom-spacing card-content-top mt-2">
                                                            <button class="quick-add__submit btn btn-primary">
                                                                <span>{{ 'products.product.add_to_cart' | t }}</span>
                                                            </button>
                                                        </div>

                                                    </div>
                                                    <div class="card-content pb-0 d-flex flex-column">

                                                        <div class="card-content-bottom mt-3">
                                                            <h3 class="fs-16 card-product-title"
                                                                aria-hidden="true">{{ 'onboarding.product_title' | t }}</h3>
                                                            <div class="d-flex flex-nowrap align-items-center">
                                                                <div class="price price--listing font-body">
                                                                    $19.99 <p class="fs-16 mb-0"><span
                                                                                class="mx-1">|</span>300g</p>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% endif %}
                                    {% if section.settings.style == 'style-4' %}
                                        <div class="card-wrapper card-product w-100 h-100">
                                            <div class="card-product-inner d-flex justify-content-between flex-column h-100">
                                                <div class="product-card style-v4 position-relative">
                                                    <div class="mb-3 overflow-hidden position-relative card-img-top-wrap">
                                                        <a class="full-width-link" aria-label="{{ 'onboarding.product_title' | t }}" href="#">
                                                            <span class="visually-hidden">{{ 'onboarding.product_title' | t }}</span>
                                                        </a>
                                                        <div class="card-img-top hover-secondary-image {% if section.settings.image_height == 'adapt' %} card-adapt{% else %} card-img-custom-height {{ section.settings.image_height }} {% endif %}">
                                                            {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                                                            {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                                                        </div>
                                                        <div class="hover-slide-bottom">
                                                            <div class="item-1 action-btn z-index-11 mx-1">
                                                                <button type="button" aria-label="Add to wishlist"
                                                                        class="btn-action btn-icon">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="24"
                                                                         height="24" viewBox="0 0 24 24" fill="none"
                                                                         stroke="currentColor" stroke-width="1.2"
                                                                         stroke-linecap="round" stroke-linejoin="round"
                                                                         class="icon-wishlist feather feather-heart">
                                                                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                                                    </svg>
                                                                </button>
                                                            </div>
                                                            <div class="item-2 mx-1">
                                                                <button class="button btn-icon">
                                                                    <i class="bi bi-eye"></i>
                                                                </button>
                                                            </div>
                                                            <button class="quick-add__submit btn btn-primary btn-icon mx-1">
                                                                <i class="bi bi-bag"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <div class="card-content pb-0 d-flex flex-column">
                                                        <div class="card-content-bottom mt-3">
                                                            <h3 class="fs-16 card-product-title"
                                                                aria-hidden="true">{{ 'onboarding.product_title' | t }}</h3>
                                                            <div class="d-flex flex-nowrap align-items-center">
                                                                <div class="price price--listing font-body">
                                                                    $19.99 <p class="fs-16 mb-0"><span
                                                                                class="mx-1">|</span>300g</p>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        {% endfor %}
                    </div>
                    {% if section.settings.products_to_show > section.settings.columns_desktop
                    and section.settings.enable_slider
                    %}
                        {% if section.settings.enable_pagination %}
                            <div class="swiper-pagination position-relative mt-4"></div>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
            {% if section.settings.enable_slider and section.settings.enable_navigation %}
                <div class="cs-navigation style-center style-v1 d-none d-md-block">
                    {% render 'navigation-prev',
                            section_id: section.id,
                            navigation_icon: section.settings.navigation_icon
                    %}

                    {% render 'navigation-next',
                            section_id: section.id,
                            navigation_icon: section.settings.navigation_icon
                    %}
                </div>
            {% endif %}
        </div>
        {% if section.settings.show_view_all %}
            <div class="text-center mt-5">
                <a
                        {% if section.settings.button_link == blank %}
                            role="link" aria-disabled="true"
                        {% else %}
                            href="{{ section.settings.button_link }}"
                        {% endif %}
                        class="btn btn-outline-primary"
                >
                    <span>{{- section.settings.button_label | escape -}}</span>
                </a>
            </div>
        {% endif %}
    </div>
</div>
{% schema %}
{
  "name": "t:sections.featured-collection.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.layout.header"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "container page-width",
          "label": "t:sections.all.layout.options__1.label"
        },
        {
          "value": "container container-inner",
          "label": "t:sections.all.layout.options__2.label"
        },
        {
          "value": "container-fluid",
          "label": "t:sections.all.layout.options__3.label"
        },
        {
          "value": "full-width",
          "label": "t:sections.all.layout.options__4.label"
        }
      ],
      "default": "container page-width",
      "label": "t:sections.all.layout.header"
    },
    {
      "type": "select",
      "id": "style",
      "options": [
        {
          "value": "style-1",
          "label": "t:sections.all.style.options__1.label"
        },
        {
          "value": "style-2",
          "label": "t:sections.all.style.options__2.label"
        },
        {
          "value": "style-3",
          "label": "t:sections.all.style.options__3.label"
        },
        {
          "value": "style-4",
          "label": "t:sections.all.style.options__4.label"
        }
      ],
      "default": "style-1",
      "label": "t:sections.all.style.label"
    },
    {
      "type": "text",
      "id": "preheading",
      "default": "Sale Off 30%",
      "label": "t:sections.all.heading.preheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "Featured Products"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options__6.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_tag.label",
      "info": "t:sections.all.heading_tag.info"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:sections.all.heading_alignment.label",
      "options": [
        {
          "value": "text-start",
          "label": "t:sections.all.heading_alignment.options__1.label"
        },
        {
          "value": "text-center",
          "label": "t:sections.all.heading_alignment.options__2.label"
        },
        {
          "value": "text-end",
          "label": "t:sections.all.heading_alignment.options__3.label"
        }
      ],
      "default": "text-center"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__0.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_size.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_size.options__6.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:sections.all.heading.subheading"
    },
    {
      "id": "collection",
      "type": "collection",
      "label": "t:sections.featured-collection.settings.collection.label"
    },
    {
