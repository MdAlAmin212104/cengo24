{% style %}
    .section-extras-spacing-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-margin-top: {{ section.settings.margin_top }}px;
    --section-margin-bottom: {{ section.settings.margin_bottom }}px;
    }
{% endstyle %}

<div
        class="
      image-with-link overflow-hidden section-extras-spacing section-extras-spacing-{{ section.id }}
      {% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}
    "
        {% if section.settings.custom_id != blank %}
            id="{{ section.settings.custom_id }}"
        {% endif %}
>
    <div class="{{ section.settings.layout }} position-relative">
        <div
                class="position-relative {{ section.settings.style_layout }}"
        >
            <div class="overflow-hidden hover-style-v1 radius-settings{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
                {% if section.settings.label_link %}
                    <a class="full-width-link" aria-label="{{ section.settings.label_link }}" href="{{ section.settings.label_link }}">
                        <span class="visually-hidden">{{ section.settings.label_link }}</span>
                    </a>
                {% endif %}
                {% if section.settings.image_mobile != blank %}
                    <div class="d-block d-md-none">
                        {% render 'image', lazyload: true, image: section.settings.image_mobile, class: 'w-100' %}
                    </div>
                {% endif %}

                {% if section.settings.image != blank %}
                    <div class="media-wrap {% if section.settings.image_mobile != blank %}d-none d-md-block{% endif %}">
                        {% render 'image-lg', lazyload: true, image: section.settings.image, class: 'w-100' %}
                    </div>
                {% else %}
                    <div class="media-wrap {% if section.settings.image_mobile != blank %}d-none d-md-block{% endif %}">
                        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg bg-body-tertiary' }}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% schema %}
{
  "name": "t:sections.image-with-link.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "container page-width",
          "label": "t:sections.all.layout.options__1.label"
        },
        {
          "value": "container container-inner",
          "label": "t:sections.all.layout.options__2.label"
        },
        {
          "value": "container-fluid",
          "label": "t:sections.all.layout.options__3.label"
        },
        {
          "value": "full-width",
          "label": "t:sections.all.layout.options__4.label"
        }
      ],
      "default": "container page-width",
      "label": "t:sections.all.layout.header"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.all.image.label"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:sections.all.image.label_mobile"
    },
    {
      "type": "url",
      "id": "label_link",
      "default": "/collections/all",
      "label": "t:sections.all.image.label_link"
    },
    {
      "type": "header",
      "content": "t:sections.all.margin.section_margin_heading"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.margin.margin_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.margin.margin_bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 100
    },
    {
      "type": "header",
      "content": "t:sections.all.mobile.header"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "t:sections.all.custom.custom_id"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.all.custom.custom_class"
    }
  ],
  "presets": [
    {
      "name": "t:sections.image-with-link.presets.name"
    }
  ]
}
{% endschema %}
