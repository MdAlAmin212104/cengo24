{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-add.min.js' | asset_url }}" defer="defer"></script>

<div class="{{ section.settings.layout }} position-relative mb-4{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  <div
    class="
      row
      gx-2
      gx-lg-{{ section.settings.gutter }}
      row-cols-{{ section.settings.columns_mobile }}
      row-cols-md-{{ section.settings.columns_tablet }}
      row-cols-lg-{{ section.settings.columns_desktop }}
    "
    grid-wishlist
  >
    <p class="wishlist__loader full-width text-center">Loading...</p>
  </div>
</div>

{% schema %}
{
   "name": "Wishlist Page",
   "tag": "section",
   "disabled_on": {
     "groups": [
       "header",
       "footer"
     ]
   },
   "settings": [
     {
       "type": "header",
       "content": "t:sections.all.layout.header"
     },
     {
       "type": "select",
       "id": "layout",
       "options": [
         {
           "value": "container page-width",
           "label": "t:sections.all.layout.options__1.label"
         },
         {
           "value": "container container-inner",
           "label": "t:sections.all.layout.options__2.label"
         },
         {
           "value": "container-fluid",
           "label": "t:sections.all.layout.options__3.label"
         },
         {
           "value": "full-width",
           "label": "t:sections.all.layout.options__4.label"
         }
       ],
       "default": "container page-width",
       "label": "t:sections.all.layout.header"
     },
     {
       "type": "range",
       "id": "columns_desktop",
       "min": 1,
       "max": 6,
       "step": 1,
       "default": 4,
       "label": "t:sections.all.columns.columns_desktop"
     },
     {
       "type": "range",
       "id": "columns_tablet",
       "min": 1,
       "max": 6,
       "step": 1,
       "default": 4,
       "label": "t:sections.all.columns.columns_tablet"
     },
     {
       "type": "select",
       "id": "columns_mobile",
       "options": [
         {
           "value": "1",
           "label": "t:sections.all.mobile.columns_mobile.options__1.label"
         },
         {
           "value": "2",
           "label": "t:sections.all.mobile.columns_mobile.options__2.label"
         }
       ],
       "default": "2",
       "label": "t:sections.all.mobile.columns_mobile.label"
     },
     {
       "type": "range",
       "id": "gutter",
       "min": 0,
       "max": 5,
       "step": 1,
       "default": 4,
       "label": "t:sections.all.columns.gutter"
     }
   ]
}
{% endschema %}
