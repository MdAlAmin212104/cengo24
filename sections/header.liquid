{% style %}
    .section-extras-color-{{ section.id }} {
    --gradient-background: {% if section.settings.color_background_gradient != blank %}{{ section.settings.color_background_gradient }}{% else %}{{ section.settings.color_background }}{% endif %};
    --color-background: {{ section.settings.color_background.red }}, {{ section.settings.color_background.green }}, {{ section.settings.color_background.blue }};
    --color-background-sub: {{ section.settings.color_background_sub.red }}, {{ section.settings.color_background_sub.green }}, {{ section.settings.color_background_sub.blue }};
    --color-text-sub: {{ section.settings.color_text_sub.red }}, {{ section.settings.color_text_sub.green }}, {{ section.settings.color_text_sub.blue }};
    --color-foreground: {{ section.settings.color_text.red }}, {{ section.settings.color_text.green }}, {{ section.settings.color_text.blue }};
    --color-border: {{ section.settings.color_border.red }}, {{ section.settings.color_border.green }}, {{ section.settings.color_border.blue }};
    }
    .section-extras-color-{{ section.id }}.header-top-center .site-nav.list--inline > li,
    .section-extras-color-{{ section.id }}.header-top-left .site-nav.list--inline > li{
    border-left: 1px solid {{ section.settings.color_border }};
    }
    .section-extras-color-{{ section.id }}.header-top-center .site-nav.list--inline > li:last-child,
    .section-extras-color-{{ section.id }}.header-top-left .site-nav.list--inline > li:last-child{
    border-right: 1px solid {{ section.settings.color_border }};
    }
{% endstyle %}

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>
<!-- OffCanvas Menu Canvas -->
<div class="offcanvas offcanvas-start offcanvas-desktop section-extras-color section-extras-color-{{ section.id }}"
     tabindex="-1" id="offcanvasMenu" aria-labelledby="offcanvasMenuLabel">
    <div class="offcanvas-body p-0 h-100 bg-white">
        <div class="border-bottom d-flex align-items-center justify-content-between px-3 py-4">
            <!--Heading-->
            <div class="w-50">
            {%- if request.page_type == 'index' -%}
                <h1 class="header__heading mb-0">
                    {%- endif -%}
                    <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
                        {%- if settings.logo != blank -%}
                            <div class="header__heading-logo-wrapper">
                                {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
                                {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
                                {% capture sizes %}(max-width: {{ settings.logo_width | times: 2 }}px) 50vw, {{ settings.logo_width }}px{% endcapture %}
                                {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
                                {{
                                settings.logo
                                | image_url: width: 600
                                | image_tag:
                                class: 'header__heading-logo motion-reduce',
                                widths: widths,
                                height: logo_height,
                                width: settings.logo_width,
                                alt: logo_alt,
                                sizes: sizes,
                                preload: true
                                }}
                            </div>
                        {%- else -%}
                            <span class="h2">{{ shop.name }}</span>
                        {%- endif -%}
                    </a>
                    {%- if request.page_type == 'index' -%}
                </h1>
                {%- endif -%}
            </div>
            <!--Button Close-->
            <button type="button" class="btn btn-reset d-block d-lg-none" data-bs-dismiss="offcanvas"
                    aria-label="Close">
                <span class="close-button style-body"></span>
            </button>
        </div>
        <div class="navbar-nav-canvas">
            {% render 'site-nav', linklist: section.settings.main_linklist, class: 'div' %}
        </div>
        {% if shop.customer_accounts_enabled and section.settings.enable_account %}
            <div class="p-3">
                {% if customer %}
                    <a href="{{ routes.account_url }}"
                       class="site-header__icon site-header__account"
                       aria-label="{{ 'layout.customer.account' | t }}">
                        <i class="bi bi-person fs-18"></i>
                        <span class="d-none">{{ 'layout.customer.account' | t }}</span>
                    </a>
                {% else %}
                    <a href="{{ routes.account_login_url }}"
                       class="site-header__icon site-header__account"
                       aria-label="{{ 'layout.customer.log_in' | t }}">
                        {{ 'layout.customer.log_in' | t }}
                    </a>/
                    <a href="{{ routes.account_register_url }}"
                       class="site-header__icon site-header__account"
                       aria-label="{{ 'layout.customer.create_account' | t }}">{{ 'layout.customer.create_account' | t }}
                    </a>
                {% endif %}
            </div>

        {% endif %}
    </div>
    <div class="offcanvas-footer">
        <ul class="navbar-nav flex-row navbar-nav-sm d-flex">
            {% if localization.available_countries.size > 1 %}
                <li class="nav-item">
                    <a
                            class="nav-link nav-link-icon"
                            href="#modal-localization"
                            data-bs-toggle="modal"
                            aria-controls="modal-localization"
                            aria-label="{{ 'accessibility.localization' | t }} {{ localization.country.name }}"
                            role="button">
                        {{ localization.country | image_url: width: 20, height: 20 | image_tag }}
                    </a>
                </li>
            {% endif %}
        </ul>
    </div>
</div>
