{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}

<div id="predictive-search-results" role="listbox">
    <div class="row d-flex justify-content-between">
        <div class="col-12 col-lg-7 col-xl-8 mb-5">
            <div class="widget-title mb-3">
                {% if predictive_search.terms == "popular" %}
                    <h3 class="h5 text-uppercase fs-20">{{ settings.title_collection }}</h3>
                {% else %}
                    {%- if predictive_search.resources.products.size > 0 -%}
                        <h3 class="h5 text-uppercase fs-20">{{ settings.title_collection }}</h3>
                    {%- else -%}
                        <h3 class="text-uppercase alert2">{{ 'general.search.no_result1' | t }}<span
                                    class="fs-16 ms-3 text-capitalize font-body">- {{ 'general.search.no_result2' | t }}</span>
                        </h3>
                    {%- endif -%}
                {%- endif -%}
            </div>
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 gx-2">
                {%- if predictive_search.resources.products.size > 0 -%}
                    {%- for product in predictive_search.resources.products limit: 5 -%}
                        {%- render 'product-card-grid-small', product: product -%}
                    {%- endfor -%}
                {%- else -%}
                    {% for product in settings.collection.products limit: 5 %}
                        {%- render 'product-card-grid-small', product: product -%}
                    {% else %}
                        {% for i in (1..5) %}
                            <div class="col mb-2">
                                <div class="product-card position-relative">
                                    <a class="full-width-link" aria-label="{{ 'onboarding.product_title' | t }}" href="#">
                                        <span class="visually-hidden">{{ 'onboarding.product_title' | t }}</span>
                                    </a>
                                    <div class="card-img-top mb-2 card-adapt">
                                        {% capture current %}{% cycle 1, 2, 3, 4 %}{% endcapture %}
                                        {{ 'product-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                                    </div>
                                    <h3 class="fs-base mb-1"
                                        aria-hidden="true">{{ 'onboarding.product_title' | t }}</h3>
                                    {% render 'product-price-listing', product: product %}
                                </div>
                            </div>
                        {% endfor %}
                    {% endfor %}
                {% endif %}
            </div>
        </div>
        <div class="col-12 col-lg-4 col-xl-3">
            {%- if predictive_search.resources.queries.size > 0 -%}
                <div class="widget mb-5">
                    <div class="widget-title mb-3">
                        <h3 class="h5 text-uppercase fs-20">{{ 'general.search.result_query' | t }}</h3>
                    </div>
                    <ul class="list-unstyled list-item p-0 m-0">
                        {%- for query_suggestions in predictive_search.resources.queries -%}
                            <li>
                                <a class="d-inline-block" href="{{ query_suggestions.url }}"
                                   title="{{ query_suggestions.text }}">
                                    {{- query_suggestions.styled_text -}}
                                </a>
                            </li>
                        {%- endfor -%}
                    </ul>
                </div>
                {%- if predictive_search.resources.collections.size > 0 -%}
                    <div class="widget mb-5">
                        <div class="widget-title mb-3">
                            <h3 class="h5 text-uppercase fs-20">{{ 'general.search.result_collections' | t }}</h3>
                        </div>
                        <ul class="list-unstyled list-item p-0 m-0">
                            {%- for collection in predictive_search.resources.collections -%}

                                <li>
                                    <a class="d-inline-block"
                                       href="{{ collection.url }}">{{ collection.title }}
                                        ({{ collection.products_count }})</a>
                                </li>
                            {%- endfor -%}
                        </ul>
                    </div>
                {%- endif -%}
                {%- if predictive_search.resources.pages.size > 0 -%}
                    <div class="widget mb-5">
                        <div class="widget-title mb-3">
                            <h3 class="h5 text-uppercase fs-20">{{ 'general.search.result_pages' | t }}</h3>
                        </div>
                        <ul class="list-unstyled list-item p-0 m-0">
                            {%- for page in predictive_search.resources.pages -%}
                                <li>
                                    <a class="d-inline-block" href="{{ page.url }}">{{ page.title }}</a>
                                </li>
                            {%- endfor -%}
                        </ul>
                    </div>
                {%- endif -%}
                {%- if predictive_search.resources.articles.size > 0 -%}
                    <div class="widget mb-5">
                        <div class="widget-title mb-3">
                            <h3 class="h5 text-uppercase fs-20">{{ 'general.search.result_blog' | t }}</h3>
                        </div>
                        <ul class="list-unstyled list-item p-0 m-0">
                            {%- for article in predictive_search.resources.articles -%}
                                <li>
                                    <a class="d-inline-block" href="{{ article.url }}">{{ article.title }}</a>
                                </li>
                            {%- endfor -%}
                        </ul>
                    </div>
                {%- endif -%}
                <div class="clearfix">
                    <button class="btn btn-primary w-100 d-block text-break">{{ 'general.search.search_for' | t }}
                        "{{ predictive_search.terms }}
                        "
                    </button>
                </div>
            {%- else -%}
                <div class="widget mb-5">
                    <div class="widget-title mb-3">
                        <h3 class="h5 text-uppercase fs-20">{{ 'general.search.result_collections1' | t }}</h3>
                    </div>
                    <ul class="list-unstyled list-item p-0 m-0">
                        {%- for collection in collections limit: 6 -%}
                            <li>
                                <a class="d-inline-block"
                                   href="{{ collection.url }}">{{ collection.title }}
                                    ({{ collection.products_count }})</a>
                            </li>
                        {%- endfor -%}
                    </ul>
                </div>
            {%- endif -%}
            <div class="d-block d-lg-none">

                <a class="btn btn-dark mt-2 w-100"
                   href="{{ routes.all_products_collection_url }}">{{ 'general.search.view_all' | t }}</a>

            </div>
        </div>
    </div>

    {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
</div>
<span class="hidden" data-predictive-search-live-region-count-value>

  </span>
