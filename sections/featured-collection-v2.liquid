{{ 'animations-swipe.css' | asset_url | stylesheet_tag }}
{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.min.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-add.min.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}
{% style %}
    .section-extras-margin-{{ section.id }} {
    --section-margin-top: {{ section.settings.margin_top }}px;
    --section-margin-bottom: {{ section.settings.margin_bottom }}px;
    }

{% if section.settings.show_border %}
  .settings-border-{{ section.id }}.settings-card{
  border: {{ section.settings.border_width }}px {{ section.settings.border_style }} {{ section.settings.color_border }};
  border-radius: {{ section.settings.border_radius }}px;
  }
{% endif %}
{% endstyle %}
<div
        class="{{ section.settings.layout }} position-relative
   section-extras-margin section-extras-margin-{{ section.id }} section-extras-color section-extras-color-{{ section.id }}
    {% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %} {{ section.settings.style_slider }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}
  "
        {% if section.settings.custom_id != blank %}
            id="{{ section.settings.custom_id }}"
        {% endif %}
>
  <div class="row row-cols-1 row-cols-lg-2 gx-4 gx-lg-5{% if section.settings.reverse %} flex-row-reverse{% endif %}">
    <div class="col">
      <div class="sticky-lg-top top-20">
      <div class="hero-slider style-v1 hero-slider-one">
        <div
                class="swiper-container overflow-hidden"
                data-slide='
      {
        "slidesPerView": 1,
        {% if section.settings.auto_rotate %}
          "autoplay": {"delay": {{ section.settings.change_slides_speed }}000},
        {% endif %}
        "speed": 400,
        "effect": "fade",
        "fadeEffect": {
          "crossFade": true
        },
        "loop": {{ section.settings.loop }},
        "autoHeight": true,
        "spaceBetween": 0,
        {% if section.settings.enable_navigation %}
          "navigation": {"nextEl": ".cs-swiper-button-next{{ section.id }}", "prevEl": ".cs-swiper-button-prev{{ section.id }}"},
        {% endif %}
        {% if section.settings.enable_pagination %}
          "pagination": {
            "el": ".swiper-pagination",
            {% if section.settings.slider_visual != blank and section.settings.slider_visual != 'bullets' %}
              "type": "{{ section.settings.slider_visual }}",
            {% endif %}
            {% if section.settings.slider_visual == 'bullets' %}
              "dynamicBullets": "true",
            {% endif %}
            "clickable": true
          },
        {% endif %}
        "spaceBetween": 0
      }
    '
        >
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              {% capture current %}{% cycle 1, 2 %}{% endcapture %}
              <div class="swiper-slide" {{ block.shopify_attributes }}>
                {% render 'banner-card-hero',
                        image: block.settings.image,
                        image_mobile: block.settings.image_mobile,
                        video: block.settings.video,
                        use_overlay: block.settings.use_overlay,
                        colors_overlay: block.settings.colors_overlay,
                        overlay_opacity: block.settings.overlay_opacity,
                        image_height: section.settings.image_height,
                        image_height_mobile: section.settings.image_height_mobile,
                        heading_tag: section.settings.heading_tag,
                        animation: block.settings.animation,
                        animation_slide: "on",
                        use_custom_colors_block: block.settings.use_custom_colors,
                        color_text_block: block.settings.color_text,
                        color_background_block: block.settings.color_background,
                        color_background_gradient_block: block.settings.color_background_gradient,
                        block_id: block.id,
                        heading: block.settings.heading,
                        heading2: block.settings.heading2,
                        heading_size: block.settings.heading_size,
                        preheading: block.settings.preheading,
                        subheading: block.settings.subheading,
                        button_label: block.settings.button_label,
                        button_link: block.settings.button_link,
                        button_style: block.settings.button_style,
                        text_box_position: block.settings.text_box_position,
                        text_alignment: block.settings.text_alignment,
                        text_alignment_mobile: block.settings.text_alignment_mobile,
                        text_box_position_mobile: block.settings.text_box_position_mobile,
                        current: current
                %}
              </div>
            {% endfor %}
          </div>
          {% if section.settings.enable_navigation and section.settings.navigation_position == 'center' %}
            {% render 'navigation',
                    section_id: section.id,
                    navigation_icon: section.settings.navigation_icon,
                    class: 'style-center style-inner d-none d-lg-block'
            %}
          {% endif %}
          {% if section.settings.enable_pagination %}
            <div class="swiper-pagination position-absolute start-50 translate-middle-x mb-4"></div>
          {% endif %}
        </div>
      </div>
      </div>
    </div>
    <div class="col">
      <div class="sticky-lg-top top-20">
        <div class="row row-cols-2 gx-4">
          {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
            <div
                    class="position-relative mb-4"
            >
              <div class="card-wrapper card-product w-100 h-100">
                {% render 'card-product',
                        card_product: product,
                        section_id: section.id,
                        image_position: 'object_position_middle_center',
                        image_height: section.settings.image_height_product,
                        show_quick_add: section.settings.enable_quick_add,
                        show_secondary_image: section.settings.show_secondary_image,
                        style_product: section.settings.style
                %}
              </div>
            </div>
          {% else %}
            {% for i in (1..section.settings.products_to_show) %}
              <div class="d-flex justify-content-between flex-column mb-4">
                {% if section.settings.style == 'style-1' %}
                  <div class="card-wrapper card-product w-100 h-100">
                    <div class="card-product-inner d-flex justify-content-between flex-column h-100">
                      <div class="product-card style-v1 position-relative">
                        <div class="mb-3 overflow-hidden position-relative">
                          <a class="full-width-link" aria-label="{{ 'onboarding.product_title' | t }}" href="#">
                            <span class="visually-hidden">{{ 'onboarding.product_title' | t }}</span>
                          </a>
                          <div class="card-img-top hover-secondary-image {% if section.settings.image_height == 'adapt' %} card-adapt{% else %} card-img-custom-height {{ section.settings.image_height }} {% endif %}">
                            {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                            {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                          </div>

                          <div class="hover-slide-left">
                            <div class="item-1 action-btn z-index-11">
                              <button type="button" aria-label="Add to wishlist"
                                      class="btn-action btn-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24"
                                     height="24" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="1.2"
                                     stroke-linecap="round" stroke-linejoin="round"
                                     class="icon-wishlist feather feather-heart">
                                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                </svg>
                              </button>
                            </div>
                            <div class="item-2 mt-2">
                              <button class="button btn-icon">
                                <i class="bi bi-eye"></i>
                              </button>
                            </div>
                          </div>
                        </div>
                        <div class="card-content pb-0">
                          <h3 class="fs-16 card-product-title mb-2"
                              aria-hidden="true">{{ 'onboarding.product_title' | t }}</h3>
                          <div class="d-flex flex-nowrap align-items-center">
                            <div class="price price--listing font-body">
                              $19.99 <p class="fs-16 mb-0"><span
                                        class="mx-1">|</span>300g</p>
                            </div>
                          </div>
                          <div class="quick-add">
                            <button class="quick-add__submit btn btn-primary">
                              {{ 'products.product.add_to_cart' | t }}
                            </button>
                          </div>

                        </div>
                      </div>
                    </div>
                  </div>
                {% endif %}
                {% if section.settings.style == 'style-2' %}
                  <div class="card-wrapper card-product w-100 h-100">
                    <div class="card-product-inner d-flex justify-content-between flex-column h-100">
                      <div class="product-card style-v2 position-relative">
                        <div class="mb-3 overflow-hidden position-relative">
                          <a class="full-width-link" aria-label="{{ 'onboarding.product_title' | t }}" href="#">
                            <span class="visually-hidden">{{ 'onboarding.product_title' | t }}</span>
                          </a>
                          <div class="card-img-top hover-secondary-image {% if section.settings.image_height == 'adapt' %} card-adapt{% else %} card-img-custom-height {{ section.settings.image_height }} {% endif %}">
                            {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                            {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                          </div>

                          <div class="hover-slide-left">
                            <div class="item-1 action-btn z-index-11">
                              <button type="button" aria-label="Add to wishlist"
                                      class="btn-action btn-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24"
                                     height="24" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="1.2"
                                     stroke-linecap="round" stroke-linejoin="round"
                                     class="icon-wishlist feather feather-heart">
                                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                </svg>
                              </button>
                            </div>
                            <div class="item-2 mt-2">
                              <button class="button btn-icon">
                                <i class="bi bi-eye"></i>
                              </button>
                            </div>
                          </div>
                          <div class="position-absolute end-0 bottom-0 mx-2 z-index-11">
                            <button class="quick-add__submit btn btn-primary btn-icon">
                              <i class="bi bi-bag"></i>
                            </button>
                          </div>
                        </div>
                        <div class="card-content pb-0">
                          <h3 class="fs-16 card-product-title mb-2"
                              aria-hidden="true">{{ 'onboarding.product_title' | t }}</h3>
                          <div class="d-flex flex-nowrap align-items-center">
                            <div class="price price--listing font-body">
                              $19.99 <p class="fs-16 mb-0"><span
                                        class="mx-1">|</span>300g</p>
                            </div>
                          </div>


                        </div>
                      </div>
                    </div>
                  </div>
                {% endif %}
                {% if section.settings.style == 'style-3' %}
                  <div class="card-wrapper card-product w-100 h-100">
                    <div class="card-product-inner d-flex justify-content-between flex-column h-100">
                      <div class="product-card style-v3 position-relative">
                        <div class="mb-3 overflow-hidden position-relative">
                          <a class="full-width-link" aria-label="{{ 'onboarding.product_title' | t }}" href="#">
                            <span class="visually-hidden">{{ 'onboarding.product_title' | t }}</span>
                          </a>
                          <div class="card-img-top hover-secondary-image {% if section.settings.image_height == 'adapt' %} card-adapt{% else %} card-img-custom-height {{ section.settings.image_height }} {% endif %}">
                            {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                            {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                          </div>

                          <div class="hover-slide-left">
                            <div class="item-1 action-btn z-index-11">
                              <button type="button" aria-label="Add to wishlist"
                                      class="btn-action btn-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24"
                                     height="24" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="1.2"
                                     stroke-linecap="round" stroke-linejoin="round"
                                     class="icon-wishlist feather feather-heart">
                                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                </svg>
                              </button>
                            </div>
                            <div class="item-2 mt-2">
                              <button class="button btn-icon">
                                <i class="bi bi-eye"></i>
                              </button>
                            </div>
                          </div>
                          <div class="custom-spacing card-content-top mt-2">
                            <button class="quick-add__submit btn btn-primary">
                              <span>{{ 'products.product.add_to_cart' | t }}</span>
                            </button>
                          </div>

                        </div>
                        <div class="card-content pb-0 d-flex flex-column">

                          <div class="card-content-bottom mt-3">
                            <h3 class="fs-16 card-product-title"
                                aria-hidden="true">{{ 'onboarding.product_title' | t }}</h3>
                            <div class="d-flex flex-nowrap align-items-center">
                              <div class="price price--listing font-body">
                                $19.99 <p class="fs-16 mb-0"><span
                                          class="mx-1">|</span>300g</p>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                {% endif %}
                {% if section.settings.style == 'style-4' %}
                  <div class="card-wrapper card-product w-100 h-100">
                    <div class="card-product-inner d-flex justify-content-between flex-column h-100">
                      <div class="product-card style-v4 position-relative">
                        <div class="mb-3 overflow-hidden position-relative card-img-top-wrap">
                          <a class="full-width-link" aria-label="{{ 'onboarding.product_title' | t }}" href="#">
                            <span class="visually-hidden">{{ 'onboarding.product_title' | t }}</span>
                          </a>
                          <div class="card-img-top hover-secondary-image {% if section.settings.image_height == 'adapt' %} card-adapt{% else %} card-img-custom-height {{ section.settings.image_height }} {% endif %}">
                            {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                            {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                          </div>

                          <div class="hover-slide-bottom">
                            <div class="item-1 action-btn z-index-11 mx-1">
                              <button type="button" aria-label="Add to wishlist"
                                      class="btn-action btn-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24"
                                     height="24" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="1.2"
                                     stroke-linecap="round" stroke-linejoin="round"
                                     class="icon-wishlist feather feather-heart">
                                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                </svg>
                              </button>
                            </div>
                            <div class="item-2 mx-1">
                              <button class="button btn-icon">
                                <i class="bi bi-eye"></i>
                              </button>
                            </div>
                            <button class="quick-add__submit btn btn-primary btn-icon mx-1">
                              <i class="bi bi-bag"></i>
                            </button>
                          </div>

                        </div>
                        <div class="card-content pb-0 d-flex flex-column">
                          <div class="card-content-bottom mt-3">
                            <h3 class="fs-16 card-product-title"
                                aria-hidden="true">{{ 'onboarding.product_title' | t }}</h3>
                            <div class="d-flex flex-nowrap align-items-center">
                              <div class="price price--listing font-body">
                                $19.99 <p class="fs-16 mb-0"><span
                                          class="mx-1">|</span>300g</p>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          {% endfor %}
        </div>
      </div>

    </div>
  </div>

</div>

{% schema %}
{
  "name": "t:sections.featured-collection-v2.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "container page-width",
          "label": "t:sections.all.layout.options__1.label"
        },
        {
          "value": "container container-inner",
          "label": "t:sections.all.layout.options__2.label"
        }
      ],
      "default": "container page-width",
      "label": "t:sections.all.layout.header"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label":  "t:sections.featured-collection-v2.reverse-lg",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.featured-collection-v2.header-1"
    },
    {
      "id": "collection",
      "type": "collection",
      "label": "t:sections.featured-collection.settings.collection.label"
    },
    {
      "type": "select",
      "id": "style",
      "options": [
        {
          "value": "style-1",
          "label": "t:sections.all.style.options__1.label"
        },
        {
          "value": "style-2",
          "label": "t:sections.all.style.options__2.label"
        },
        {
          "value": "style-3",
          "label": "t:sections.all.style.options__3.label"
        },
        {
          "value": "style-4",
          "label": "t:sections.all.style.options__4.label"
        }
      ],
      "default": "style-1",
      "label": "t:sections.all.style.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 48,
      "step": 1,
      "default": 8,
      "label": "t:sections.featured-collection.settings.products_to_show.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.header.product-card"
    },
    {
      "type": "select",
      "id": "image_height_product",
      "options": [
        {
          "group": "t:sections.all.image.image_height.adapt",
          "value": "adapt",
          "label": "t:sections.all.image.image_height.adapt"
        },
        {
          "group": "t:sections.all.image.image_height.portrait",
          "value": "h-ratio-2-1",
          "label": "2:1"
        },
        {
          "group": "t:sections.all.image.image_height.portrait",
          "value": "h-ratio-16-9",
          "label": "16:9"
        },
        {
          "group": "t:sections.all.image.image_height.portrait",
          "value": "h-ratio-8-5",
          "label": "8:5"
        },
        {
          "group": "t:sections.all.image.image_height.portrait",
          "value": "h-ratio-3-2",
          "label": "3:2"
        },
        {
          "group": "t:sections.all.image.image_height.portrait",
          "value": "h-ratio-4-3",
          "label": "4:3"
        },
        {
          "group": "t:sections.all.image.image_height.squared",
          "value": "h-ratio-1-1",
          "label": "1:1"
        },
        {
          "group": "t:sections.all.image.image_height.landscape",
          "value": "h-ratio-4-5",
          "label": "4:5"
        },
        {
          "group": "t:sections.all.image.image_height.landscape",
          "value": "h-ratio-3-4",
          "label": "3:4"
        },
        {
          "group": "t:sections.all.image.image_height.landscape",
          "value": "h-ratio-2-3",
          "label": "2:3"
        },
        {
          "group": "t:sections.all.image.image_height.landscape",
          "value": "h-ratio-1-2",
          "label": "1:2"
        }
      ],
      "default": "adapt",
      "label": "t:sections.all.image.image_height.label_ratio",
      "info": "t:sections.all.image.image_height.info"
    },
    {
      "type": "select",
      "id": "image_position",
      "options": [
        {
          "value": "object_position_top_left",
          "label": "t:sections.all.image.image_position.options__1.label"
        },
        {
          "value": "object_position_top_center",
          "label": "t:sections.all.image.image_position.options__2.label"
        },
        {
          "value": "object_position_top_right",
          "label": "t:sections.all.image.image_position.options__3.label"
        },
        {
          "value": "object_position_middle_left",
          "label": "t:sections.all.image.image_position.options__4.label"
        },
        {
          "value": "object_position_middle_center",
          "label": "t:sections.all.image.image_position.options__5.label"
        },
        {
          "value": "object_position_middle_right",
          "label": "t:sections.all.image.image_position.options__6.label"
        },
        {
          "value": "object_position_bottom_left",
          "label": "t:sections.all.image.image_position.options__7.label"
        },
        {
          "value": "object_position_bottom_center",
          "label": "t:sections.all.image.image_position.options__8.label"
        },
        {
          "value": "object_position_bottom_right",
          "label": "t:sections.all.image.image_position.options__9.label"
        }
      ],
      "default": "object_position_middle_center",
      "label": "t:sections.all.image.image_position.label"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "default": true,
      "label": "t:sections.featured-collection.settings.enable_quick_buy.label"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "t:sections.featured-collection.settings.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "t:sections.all.border.label",
      "default": true
    },
    {
      "type": "color",
      "id": "color_border",
      "label": "t:sections.all.color_options.color_border",
      "default": "#ebebeb"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 10,
      "unit": "px",
      "step": 1,
      "default": 0,
      "label": "t:sections.all.border.border_radius"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 5,
      "unit": "px",
      "step": 1,
      "default": 1,
      "label": "t:sections.all.border.border_width"
    },
    {
      "type": "select",
      "id": "border_style",
      "options": [
        {
          "value": "solid",
          "label": "t:sections.all.border.border_style.solid"
        },
        {
          "value": "dashed",
          "label": "t:sections.all.border.border_style.dashed"
        },
        {
          "value": "dotted",
          "label": "t:sections.all.border.border_style.dotted"
        },
        {
          "value": "double",
          "label": "t:sections.all.border.border_style.double"
        }
      ],
      "default": "solid",
      "label": "t:sections.all.border.border_style.label"
