{% style %}
    .section-extras-spacing-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-margin-top: {{ section.settings.margin_top }}px;
    --section-margin-bottom: {{ section.settings.margin_bottom }}px;
    }

    {% if section.settings.use_custom_colors %}
        .section-extras-color-{{ section.id }} {
        --gradient-background: {% if section.settings.color_background_gradient != blank %}{{ section.settings.color_background_gradient }}{% else %}{{ section.settings.color_background }}{% endif %};
        --color-background: {{ section.settings.color_background.red }}, {{ section.settings.color_background.green }}, {{ section.settings.color_background.blue }};
        --color-foreground: {{ section.settings.color_text.red }}, {{ section.settings.color_text.green }}, {{ section.settings.color_text.blue }};
        }
    {% endif %}
{% endstyle %}
<div
        class="
    section-extras-spacing section-extras-spacing-{{ section.id }} {% if section.settings.use_custom_colors %} section-extras-color section-extras-color-{{ section.id }} {% endif %}
    {% if section.settings.background_image != blank %} section-have-background-image position-relative overflow-hidden{% endif %}
    {% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}
  "
        {% if section.settings.custom_id != blank %}
            id="{{ section.settings.custom_id }}"
        {% endif %}
>
    <div class="container page-width">
        {% if section.settings.preheading != '' or section.settings.heading != '' or section.settings.subheading != '' %}
            <div class="cs-section-header {{ section.settings.heading_alignment }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
                {% render 'heading',
                        heading: section.settings.heading,
                        class: '',
                        heading_tag: section.settings.heading_tag,
                        heading_size: section.settings.heading_size,
                        preheading: section.settings.preheading,
                        subheading: section.settings.subheading
                %}
            </div>
        {% endif %}
        <div class="row">
            {% assign blog = blogs[section.settings.blog] %}
            <div class="col col-12 col-xl-6 mb-5 mb-xl-0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
                <div class="sticky-lg-top top-20">
                    {% for article in blog.articles limit: section.settings.post_limit %}

                        {% if forloop.index == 1 %}
                            <div
                                 class="card-wrapper"
                            >
                                {% render 'blog-card-grid',
                                        article: article,
                                        title_size: 'h5',
                                        blog_title: blog.title,
                                        blog_url: blog.url,
                                        blog_show_date: section.settings.blog_show_date,
                                        blog_show_excerpt: section.settings.blog_show_excerpt,
                                        image_position: section.settings.image_position,
                                        image_height: section.settings.image_height
                                %}
                            </div>
                        {% endif %}
                    {% else %}
                        <div
                             class="card-wrapper w-100 h-100 mb-5"
                        >
                            <div class="card-wrapper w-100 h-100">
                                <div class="cs-card blog-card position-relative">
                                    <div class="position-relative">
                                        <div class="card-img-top card-hover-overlay-dark lh-0 d-block overflow-hidden">
                                            {{ 'image' | placeholder_svg_tag: 'placeholder-svg bg-body-tertiary' }}
                                        </div>
                                    </div>
                                    <div class="cs-card-body d-flex flex-column justify-content-between flex-1 pt-3 pt-md-4">
                                        <div class="clearfix">
                                            {% if section.settings.blog_show_date %}
                                                <div class="d-flex align-items-center flex-wrap fs-12 text-uppercase letter-spacing-2">
                                                    <p class="mb-1">
                                                        {{ 'onboarding.blog_date' | t }}
                                                    </p>
                                                </div>
                                            {% endif %}
                                            <h3 class="h4 mb-0">
                                                <a href="#">{{ 'onboarding.blog_title' | t }}</a>
                                            </h3>
                                            {% if section.settings.blog_show_excerpt %}
                                                <div class="rte rte-inline mt-2">
                                                    {{ 'onboarding.blog_excerpt' | t }}
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div class="clearfix mt-3">
                                            <a
                                                    href="#"
                                                    class="hover-underline d-inline-block text-uppercase fs-12"
                                            >
                                                {{ 'onboarding.read_more' | t -}}
                                            </a>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
            <div class="col col-12 col-xl-6{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
                <div class="row d-flex justify-content-center">
                    <div class="col-12 col-xl-10">
                        <div class="row">
                            {% for article in blog.articles limit: section.settings.post_limit %}
                                {% if forloop.index != 1 %}
                                    <div class="col col-12 col-sm-6 col-lg-4 col-xl-12 mb-5">
                                        <div class="card-wrapper w-100 h-100">
                                            {% render 'blog-card-grid',
                                                    article: article,
                                                    title_size: 'h5',
                                                    blog_title: blog.title,
                                                    blog_url: blog.url,
                                                    blog_show_date: section.settings.blog_show_date,
                                                    blog_show_excerpt: section.settings.blog_show_excerpt,
                                                    image_position: section.settings.image_position,
                                                    image_height: section.settings.image_height
                                            %}
                                        </div>
                                    </div>
                                {% endif %}
                            {% else %}
                                {% for i in (1..3) %}
                                    <div class="col col-12 col-sm-6 col-lg-4 col-xl-12 mb-5">
                                        <div class="card-wrapper w-100 h-100">
                                            <div class="cs-card blog-card position-relative">
                                                <div class="position-relative">
                                                    <div class="card-img-top card-hover-overlay-dark lh-0 d-block overflow-hidden">
                                                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg bg-body-tertiary' }}
                                                    </div>
                                                </div>
                                                <div class="cs-card-body d-flex flex-column justify-content-between flex-1 pt-3 pt-md-4">
                                                    <div class="clearfix">
                                                        {% if section.settings.blog_show_date %}
                                                            <div class="d-flex align-items-center flex-wrap fs-12 text-uppercase letter-spacing-2">
                                                                <p class="mb-1">
                                                                    {{ 'onboarding.blog_date' | t }}
                                                                </p>
                                                            </div>
                                                        {% endif %}
                                                        <h3 class="h6 mb-0">
                                                            <a href="#">{{ 'onboarding.blog_title' | t }}</a>
                                                        </h3>
                                                    </div>
                                                    <div class="clearfix mt-4">
                                                        <a
                                                                href="#"
                                                                class="hover-underline d-inline-block text-uppercase fs-12"
                                                        >
                                                            {{ 'onboarding.read_more' | t -}}
                                                        </a>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
