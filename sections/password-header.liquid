<div class="password-content container page-width">
  {% if settings.logo %}
    <a href="{{ routes.root_url }}"
       class="site-header__logo-image d-flex align-items-center justify-content-center"
       data-image-loading-animation>
      {% render 'image-sm',lazyload: false, image: settings.logo, width: settings.logo_width %}
    </a>
  {% else %}
  <h1><a class="site-header__logo-link h6 text-uppercase fw-bold"
           href="{{ routes.root_url }}">{{ shop.name }}</a></h1>
  {% endif %}

  <h2 class="password-content__title m-0">{{ section.settings.header | escape }}</h2>
</div>

{% schema %}
{
  "name": "t:sections.password-header.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.password-header.settings.logo.label"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "t:sections.password-header.settings.logo_max_width.label",
      "min": 50,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "text",
      "id": "header",
      "label": "t:sections.password-header.settings.header.label",
      "default": "Coming Soon"
    }
  ]
}
{% endschema %}
